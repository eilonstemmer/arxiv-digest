# arxiv-digest bootstrap env vars
#
# These are OPTIONAL — you can leave most blank and configure
# everything via the Settings tab at http://localhost:8080/settings
# after first launch.
#
# Settings stored in the database take precedence over these env vars.
# Use env vars only for headless deployments (servers, CI).

# ANTHROPIC_API_KEY=
# NOTIFY_EMAIL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# WEBHOOK_SECRET is the one thing that MUST be set before first run.
# It protects the internal pipeline->webapp callback. Any long random string.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# Optional
TZ=UTC
