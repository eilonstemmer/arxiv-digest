<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}arxiv-digest{% endblock %}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/htmx.org@1.9.10"></script>
</head>
<body class="bg-gray-50 text-gray-900 min-h-screen">

  <header class="bg-white border-b border-gray-200 shadow-sm">
    <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
      <a href="/" class="text-xl font-bold text-indigo-700 hover:text-indigo-900">arxiv-digest</a>
      <nav class="flex gap-4 text-sm font-medium">
        <a href="/"        class="hover:text-indigo-600">Home</a>
        <a href="/digests" class="hover:text-indigo-600">Digests</a>
        <a href="/trends"  class="hover:text-indigo-600">Trends</a>
        <a href="/search"  class="hover:text-indigo-600">Search</a>
        <a href="/settings" class="hover:text-indigo-600">Settings</a>
      </nav>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-4 py-8">
    {% block content %}{% endblock %}
  </main>

  <footer class="border-t border-gray-200 mt-12 py-4 text-center text-xs text-gray-400">
    arxiv-digest &mdash; local self-hosted
  </footer>

</body>
</html>
