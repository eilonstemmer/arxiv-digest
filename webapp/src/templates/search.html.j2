{% extends "_base.html.j2" %}
{% block title %}Search — arxiv-digest{% endblock %}

{% block content %}
<h1 class="text-2xl font-bold mb-6">Search Papers</h1>

<form method="get" action="/search" class="flex gap-2 mb-6">
  <input type="text" name="q" value="{{ query | e }}" placeholder="Search titles and abstracts…"
         class="flex-1 border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:border-indigo-400">
  <button type="submit"
          class="bg-indigo-600 text-white rounded px-4 py-2 text-sm hover:bg-indigo-700">
    Search
  </button>
</form>

{% if semantic_deferred %}
<p class="text-xs text-gray-400 mb-4">
  Full-text search (FTS5). Semantic search is deferred to v2 — the webapp avoids
  the sentence-transformers dependency.
</p>
{% endif %}

{% if query %}
  {% if results %}
    <p class="text-sm text-gray-500 mb-4">{{ results | length }} result(s) for <em>{{ query | e }}</em></p>
    <div class="space-y-3">
      {% for r in results %}
      <a href="/papers/{{ r.arxiv_id }}"
         class="block bg-white border border-gray-200 rounded-lg px-5 py-4 hover:border-indigo-400 hover:shadow transition">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="font-semibold text-indigo-700 leading-tight">{{ r.title }}</p>
            <p class="text-xs text-gray-500 mt-1">{{ r.authors[:80] }}{% if r.authors|length > 80 %}…{% endif %}</p>
          </div>
          <div class="text-right text-xs text-gray-400 shrink-0">
            <div>{{ r.primary_category }}</div>
            <div>{{ r.published_at[:10] }}</div>
          </div>
        </div>
      </a>
      {% endfor %}
    </div>
  {% else %}
    <p class="text-gray-500">No results for <em>{{ query | e }}</em>.</p>
  {% endif %}
{% endif %}
{% endblock %}
