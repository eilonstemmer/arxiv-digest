{% extends "_base.html.j2" %}
{% block title %}{{ paper.title[:60] }} — arxiv-digest{% endblock %}

{% block content %}
<div class="mb-4">
  <a href="javascript:history.back()" class="text-sm text-gray-500 hover:text-indigo-600">&larr; Back</a>
</div>

<article class="bg-white border border-gray-200 rounded-lg p-6">
  <h1 class="text-xl font-bold mb-2">{{ paper.title }}</h1>

  <div class="flex flex-wrap gap-2 text-sm text-gray-600 mb-4">
    <span class="bg-indigo-50 text-indigo-700 rounded px-2 py-0.5">{{ paper.primary_category }}</span>
    <span>{{ paper.published_at[:10] }}</span>
    {% if paper.relevance_score is not none %}
      <span class="bg-green-50 text-green-700 rounded px-2 py-0.5">Score: {{ "%.1f"|format(paper.relevance_score) }}</span>
    {% endif %}
    {% if paper.upvoted %}
      <span class="bg-yellow-50 text-yellow-700 rounded px-2 py-0.5">Upvoted</span>
    {% endif %}
  </div>

  <p class="text-xs text-gray-500 mb-4">{{ paper.authors }}</p>

  <p class="text-gray-800 leading-relaxed mb-6">{{ paper.abstract }}</p>

  <div class="flex gap-3">
    <a href="{{ paper.url_abs }}" target="_blank" rel="noopener"
       class="text-sm bg-indigo-600 text-white rounded px-3 py-1.5 hover:bg-indigo-700">
      View on arXiv
    </a>
    <a href="{{ paper.url_pdf }}" target="_blank" rel="noopener"
       class="text-sm bg-gray-100 text-gray-700 rounded px-3 py-1.5 hover:bg-gray-200">
      PDF
    </a>
    {% if not paper.upvoted %}
    <button
      hx-post="/papers/{{ paper.arxiv_id }}/upvote"
      hx-swap="outerHTML"
      class="text-sm bg-yellow-50 text-yellow-700 border border-yellow-300 rounded px-3 py-1.5 hover:bg-yellow-100 cursor-pointer">
      Upvote
    </button>
    {% endif %}
  </div>
</article>

{% if summary %}
<section class="mt-6 bg-white border border-gray-200 rounded-lg p-6">
  <h2 class="text-lg font-semibold mb-4">AI Summary</h2>
  <dl class="space-y-3 text-sm">
    <div>
      <dt class="font-semibold text-gray-700">Problem</dt>
      <dd class="text-gray-800 mt-1">{{ summary.problem }}</dd>
    </div>
    <div>
      <dt class="font-semibold text-gray-700">Method</dt>
      <dd class="text-gray-800 mt-1">{{ summary.method }}</dd>
    </div>
    <div>
      <dt class="font-semibold text-gray-700">Key Result</dt>
      <dd class="text-gray-800 mt-1">{{ summary.key_result }}</dd>
    </div>
    <div>
      <dt class="font-semibold text-gray-700">Why It Matters</dt>
      <dd class="text-gray-800 mt-1">{{ summary.why_it_matters }}</dd>
    </div>
    <div>
      <dt class="font-semibold text-gray-700">Novelty</dt>
      <dd class="mt-1">
        <span class="bg-purple-50 text-purple-700 rounded px-2 py-0.5">{{ summary.novelty_signal }}</span>
      </dd>
    </div>
    {% if summary.tags %}
    <div>
      <dt class="font-semibold text-gray-700">Tags</dt>
      <dd class="mt-1 flex flex-wrap gap-1">
        {% for tag in summary.tags | from_json %}
          <span class="bg-gray-100 text-gray-600 text-xs rounded px-2 py-0.5">{{ tag }}</span>
        {% endfor %}
      </dd>
    </div>
    {% endif %}
  </dl>
  <p class="mt-4 text-xs text-gray-400">Generated {{ summary.generated_at[:10] }} by {{ summary.model }}</p>
</section>
{% endif %}

{% endblock %}
