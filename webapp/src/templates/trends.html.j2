{% extends "_base.html.j2" %}
{% block title %}Trends — arxiv-digest{% endblock %}

{% block content %}
<h1 class="text-2xl font-bold mb-2">Research Trends</h1>

{% if not digest_id %}
  <div class="bg-yellow-50 border border-yellow-200 rounded p-6 text-yellow-800 mt-6">
    <p class="font-semibold">No weekly digest found.</p>
    <p class="mt-1 text-sm">Run the pipeline to generate trend data.</p>
  </div>
{% else %}
  <p class="text-sm text-gray-500 mb-6">Week: <strong>{{ digest_id }}</strong> &middot; Generated {{ generated_at[:10] }}</p>

  {% if trend_narrative %}
  <section class="bg-white border border-gray-200 rounded-lg p-6 mb-6">
    <h2 class="text-lg font-semibold mb-3">Narrative Summary</h2>
    {% if trend_narrative is mapping %}
      {% for key, val in trend_narrative.items() %}
        <div class="mb-3">
          <dt class="font-semibold text-gray-700 text-sm">{{ key }}</dt>
          <dd class="text-gray-800 text-sm mt-1">
            {% if val is string %}{{ val }}
            {% else %}{{ val | tojson(indent=2) }}{% endif %}
          </dd>
        </div>
      {% endfor %}
    {% else %}
      <pre class="text-xs text-gray-700 whitespace-pre-wrap">{{ trend_narrative | tojson(indent=2) }}</pre>
    {% endif %}
  </section>
  {% endif %}

  {% if cluster_trends %}
  <section>
    <h2 class="text-lg font-semibold mb-4">Cluster Trends</h2>
    <div class="space-y-3">
      {% for ct in cluster_trends %}
      <div class="bg-white border border-gray-200 rounded-lg px-5 py-4">
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="font-semibold">{{ ct.label }}</p>
            <p class="text-sm text-gray-600 mt-1">{{ ct.description }}</p>
          </div>
          <div class="text-right text-sm shrink-0">
            <div class="text-gray-500">{{ ct.paper_count }} papers</div>
            {% if ct.velocity_class %}
            <div class="mt-1">
              {% if ct.velocity_class == 'accelerating' %}
                <span class="bg-green-100 text-green-700 text-xs rounded px-2 py-0.5">accelerating</span>
              {% elif ct.velocity_class == 'growing' %}
                <span class="bg-blue-100 text-blue-700 text-xs rounded px-2 py-0.5">growing</span>
              {% elif ct.velocity_class == 'flat' %}
                <span class="bg-gray-100 text-gray-600 text-xs rounded px-2 py-0.5">flat</span>
              {% else %}
                <span class="bg-red-100 text-red-700 text-xs rounded px-2 py-0.5">{{ ct.velocity_class }}</span>
              {% endif %}
            </div>
            {% endif %}
          </div>
        </div>
        <div class="flex gap-4 mt-3 text-xs text-gray-500">
          {% if ct.delta_vs_w1 is not none %}
            <span>vs W-1: {{ "%+.0f%%"|format(ct.delta_vs_w1 * 100) }}</span>
          {% endif %}
          {% if ct.delta_vs_w4 is not none %}
            <span>vs W-4: {{ "%+.0f%%"|format(ct.delta_vs_w4 * 100) }}</span>
          {% endif %}
          {% if ct.delta_vs_w12 is not none %}
            <span>vs W-12: {{ "%+.0f%%"|format(ct.delta_vs_w12 * 100) }}</span>
          {% endif %}
          {% if ct.is_new %}
            <span class="bg-purple-50 text-purple-600 rounded px-1">new cluster</span>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </section>
  {% else %}
    <p class="text-gray-500">No cluster trend data available for this digest yet.</p>
  {% endif %}
{% endif %}
{% endblock %}
